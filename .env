# Environment variables.
# Vite only exposes variables prefixed `VITE_`.
# Override locally in gitignored .env.local.

#   .env             loaded in every mode
#   .env.production  loaded by `npm run build`, overrides .env
#   .env.local       optional, gitignored, overrides both

# DCMS API collections. Absolute URLs, no trailing slash.
VITE_API_VIDEOS=https://dcms.dyalog.com/videos
VITE_API_EVENTS=https://dcms.dyalog.com/events
VITE_API_PRESENTERS=https://dcms.dyalog.com/presenters

# Path the SPA is served under; the router strips it from every URL.
# "/" for the dev server, "/video-library" on the live WordPress site.
VITE_BASENAME=/

# URL prefix for files in public/assets (icons, placeholder images). "/assets"
# in dev. Live, it is the theme path and must agree with `base` in
# vite.config.ts.
VITE_ASSETS_PREFIX=/assets
